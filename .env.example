# Supabase(ローカルは `pnpm db:start` の出力値を .env.local に設定)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# アプリ
APP_URL=http://localhost:3000

# メール(Resend) — S6 で使用
RESEND_API_KEY=
# 差出人アドレス。本番は認証済みドメインを設定(未設定なら Resend 共有ドメイン)
EMAIL_FROM_ADDRESS=

# Vercel Cron 認証 — S6 で使用
CRON_SECRET=
