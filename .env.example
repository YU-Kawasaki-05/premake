# Supabase(ローカルは `pnpm db:start` の出力値を .env.local に設定)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# アプリ
APP_URL=http://localhost:3000

# メール(Resend) — S6 で使用
RESEND_API_KEY=
# 差出人アドレス。本番は認証済みドメインを設定(未設定なら Resend 共有ドメイン)
EMAIL_FROM_ADDRESS=

# Vercel Cron 認証 — S6 で使用
CRON_SECRET=

# エラー監視・cron 死活監視(Sentry) — 任意。未設定なら監視は完全に無効(挙動は変わらない)
# 本番は設定を推奨。sentry.io でプロジェクトを作り、発行された DSN を貼る
SENTRY_DSN=
